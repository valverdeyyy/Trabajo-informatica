#include <stdio.h>
#include <string.h>

#define MAX_ACTIVIDADES 5100
#define MAX_CAMPO       64

typedef struct {
    int  anio;
    int  mes;
    int  dia;
    char dia_semana[MAX_CAMPO];
    char hora_inicio[MAX_CAMPO];
    char hora_fin[MAX_CAMPO];
    char actividad_base[MAX_CAMPO];
    char modalidad[MAX_CAMPO];
    char centro[MAX_CAMPO];
    int  plazas;
    int  ocupadas;
    int  libres;
    char tipo_actividad[MAX_CAMPO];
} Actividad;

Actividad actividades[MAX_ACTIVIDADES];
int total = 0;

int cargar_csv(const char *ruta) {
    FILE *f = fopen(ruta, "r");
    if (f == NULL) {
        printf("Error: no se pudo abrir '%s'\n", ruta);
        return 0;
    }

    char linea[512];
    fgets(linea, sizeof(linea), f);

    total = 0;
    while (fgets(linea, sizeof(linea), f) != NULL && total < MAX_ACTIVIDADES) {
        linea[strcspn(linea, "\n")] = '\0';

        Actividad a;
        int leidos = sscanf(linea,
            "%d %d %d %s %s %s %s %s %s %d %d %d %s",
            &a.anio, &a.mes, &a.dia,
            a.dia_semana,
            a.hora_inicio, a.hora_fin,
            a.actividad_base, a.modalidad, a.centro,
            &a.plazas, &a.ocupadas, &a.libres,
            a.tipo_actividad);

        if (leidos == 13) {
            actividades[total] = a;
            total++;
        }
    }

    fclose(f);
    printf("Se cargaron %d actividades.\n\n", total);
    return 1;
}

void ordenar_por_lugar();
void ordenar_por_horario();
void ordenar_por_actividad();
void ordenar_por_libres();
int  hora_a_minutos(const char *hora);
void mostrar_actividades(int n);

void menu_ordenar() {
    int opcion;

    printf("=== ORDENAR ACTIVIDADES ===\n");
    printf("1) Por lugar (centro deportivo)\n");
    printf("2) Por horario (hora de inicio)\n");
    printf("3) Por actividad (nombre)\n");
    printf("4) Por plazas libres (mayor a menor)\n");
    printf("0) Salir\n");
    printf("Elige una opcion: ");
    scanf("%d", &opcion);

    switch (opcion) {
        case 1:
            ordenar_por_lugar();
            printf("\n--- Actividades ordenadas por LUGAR ---\n\n");
            mostrar_actividades(total);
            break;

        case 2:
            ordenar_por_horario();
            printf("\n--- Actividades ordenadas por HORARIO ---\n\n");
            mostrar_actividades(total);
            break;

        case 3:
            ordenar_por_actividad();
            printf("\n--- Actividades ordenadas por ACTIVIDAD ---\n\n");
            mostrar_actividades(total);
            break;

        case 4:
            ordenar_por_libres();
            printf("\n--- Actividades ordenadas por PLAZAS LIBRES ---\n\n");
            mostrar_actividades(total);
            break;

        case 0:
            printf("Hasta luego.\n");
            break;

        default:
            printf("Opcion no valida.\n");
    }
}

void ordenar_por_lugar() {
    int i, j;
    Actividad temp;

    for (i = 0; i < total - 1; i++) {
        for (j = 0; j < total - 1 - i; j++) {
            if (strcmp(actividades[j].centro, actividades[j+1].centro) > 0) {
                temp             = actividades[j];
                actividades[j]   = actividades[j+1];
                actividades[j+1] = temp;
            }
        }
    }
}

void ordenar_por_horario() {
    int i, j;
    Actividad temp;

    for (i = 0; i < total - 1; i++) {
        for (j = 0; j < total - 1 - i; j++) {
            if (hora_a_minutos(actividades[j].hora_inicio) >
                hora_a_minutos(actividades[j+1].hora_inicio)) {
                temp             = actividades[j];
                actividades[j]   = actividades[j+1];
                actividades[j+1] = temp;
            }
        }
    }
}

void ordenar_por_actividad() {
    int i, j;
    Actividad temp;

    for (i = 0; i < total - 1; i++) {
        for (j = 0; j < total - 1 - i; j++) {
            if (strcmp(actividades[j].actividad_base, actividades[j+1].actividad_base) > 0) {
                temp             = actividades[j];
                actividades[j]   = actividades[j+1];
                actividades[j+1] = temp;
            }
        }
    }
}

void ordenar_por_libres() {
    int i, j;
    Actividad temp;

    for (i = 0; i < total - 1; i++) {
        for (j = 0; j < total - 1 - i; j++) {
            if (actividades[j].libres < actividades[j+1].libres) {
                temp             = actividades[j];
                actividades[j]   = actividades[j+1];
                actividades[j+1] = temp;
            }
        }
    }
}

int hora_a_minutos(const char *hora) {
    int h = 0, m = 0;
    sscanf(hora, "%d:%d", &h, &m);
    return h * 60 + m;
}

void mostrar_actividades(int n) {
    int i;
    if (n > total) n = total;

    printf("%-30s %-10s %-8s %-35s %s\n",
           "Centro", "Hora ini", "Hora fin", "Actividad", "Libres");
    printf("%-30s %-10s %-8s %-35s %s\n",
           "------------------------------", "----------", "--------",
           "-----------------------------------", "------");

    for (i = 0; i < n; i++) {
        printf("%-30s %-10s %-8s %-35s %d\n",
               actividades[i].centro,
               actividades[i].hora_inicio,
               actividades[i].hora_fin,
               actividades[i].actividad_base,
               actividades[i].libres);
    }
    printf("(mostrando %d de %d)\n\n", n, total);
}

int main(int argc, char *argv[]) {
    const char *ruta = "dataset.csv";

    if (argc >= 2) {
        ruta = argv[1];
    }

    if (!cargar_csv(ruta)) {
        return 1;
    }

    menu_ordenar();

    return 0;
}
