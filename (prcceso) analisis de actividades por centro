#include <stdio.h>
#include <string.h>
#include <stdlib.h>


#define MAX_ACTIVIDADES 5100
#define MAX_CAMPO        64
#define MAX_CENTROS      50
#define MAX_LINEA       1024 // Un poco mas grande por si acaso

// Estructura para cada fila del csv
typedef struct {
    char dia_semana[MAX_CAMPO];
    char hora_inicio[MAX_CAMPO];
    char actividad_base[MAX_CAMPO];
    char centro[MAX_CAMPO];
    int  ocupadas;
} Actividad;

// Estructura para el resumen de cada centro
typedef struct {
    char nombre[MAX_CAMPO];
    char dia_top[MAX_CAMPO];
    char actividad_top[MAX_CAMPO];
    int  max_ocupacion; // Para saber que dia fue el mas lleno
} InfoCentro;

// Idea extraida del ejercicio del parcial
char palindroma_caracter(char c) {
    char resultado = c;

  if (c == '_') {
        resultado = ' ';
    } else if (c >= 'A' && c <= 'Z') {
        resultado = (c + 32);
}
return resultado;
}

void palindroma_string(const char *original, char *pldm, int max) {
    int i = 0, j = 0;
    while (original[i] != '\0' && j < max - 1) {
        pldm[j] = palindroma_caracter(original[i]);
        i++;
        j++;
    }
    pldm[j] = '\0';
}

int palindroma(const char *texto, const char *busqueda) {
    char texto_norm[MAX_CAMPO];
    char busca_norm[MAX_CAMPO];
    palindroma_string(texto,    texto_norm, MAX_CAMPO);
    palindroma_string(busqueda, busca_norm, MAX_CAMPO);

    int len = (int)strlen(busca_norm);
    int encontrado = 0;
    int i = 0;

    while (texto_norm[i] != '\0' && encontrado == 0) {
        if (texto_norm[i] == busca_norm[0]) {
            int j = 0;
            int coincide = 1;
            while (j < len && coincide == 1) {
                if (texto_norm[i + j] == '\0' ||
                    texto_norm[i + j] != busca_norm[j]) {
                    coincide = 0;
                }
                j++;
            }
            if (coincide == 1) {
                encontrado = 1;
            }
        }
        i++;
    }
    return encontrado;
}
// Funcion para extraer datos adaptada a espacios
void extraer_dato_real(const char *linea, int col, char *dest) {
    int campo_actual = 0;
    int i = 0;
    int j = 0;

    // Buscamos la columna saltando espacios
    while (linea[i] != '\0' && campo_actual < col) {
        if (linea[i] == ' ' || linea[i] == '\t') {
            campo_actual++;
            // Saltamos espacios seguidos si los hay
            while (linea[i+1] == ' ' || linea[i+1] == '\t') i++;
        }
        i++;
    }

    // Copiamos el contenido de la columna
    while (linea[i] != '\0' && linea[i] != ' ' && linea[i] != '\t' && linea[i] != '\n' && j < MAX_CAMPO - 1) {
        dest[j++] = linea[i++];
    }
    dest[j] = '\0';
}

int main() {
