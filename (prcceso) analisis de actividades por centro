        }

        // Si tenemos el centro actualizamos sus records
        if (idx_centro != -1) {
            // Si la fila actual tiene mas gente que el record del centro, guardamos los datos
            if (datos[total_leidas].ocupadas >= centros[idx_centro].max_ocupacion) {
                centros[idx_centro].max_ocupacion = datos[total_leidas].ocupadas;
                strcpy(centros[idx_centro].dia_top, datos[total_leidas].dia_semana);
                strcpy(centros[idx_centro].actividad_top, datos[total_leidas].actividad_base);
            }
        }
        total_leidas++;
    }
    fclose(f);

    if (total_leidas > 0) {
        printf("\n   ANALISIS DE ACTIVIDAD POR CENTRO \n");
        printf("   ------------------------------------------------------------\n");
