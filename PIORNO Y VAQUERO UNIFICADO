// Funcion para convertir texto (string) en numero (int)
// El nombre es por una funcion "universal" de otra libreria no disponible
int atoi(const char *s) {

	int resultado = 0;  // Para guardar el número
    int signo     = 1;  // Por si es negativo

    while (*s == ' ' || *s == '\t') s++;

    if      (*s == '-') { signo = -1; s++; }
    else if (*s == '+') { s++; }

    while (*s >= '0' && *s <= '9') {
        resultado = resultado * 10 + (*s - '0'); // Si tien mas de decenas, las va "moviendo" a la izquierda
        s++;
    }
    return signo * resultado;
}


// Idea extraida del ejercicio del parcial
char palindroma_caracter(char c) {
    char resultado = c;

  if (c == '_') {
        resultado = ' ';
    } else if (c >= 'A' && c <= 'Z') {
        resultado = (c + 32);
}
return resultado;
}

void palindroma_string(const char *original, char *pldm, int max) {
    int i = 0, j = 0;
    while (original[i] != '\0' && j < max - 1) {
        pldm[j] = palindroma_caracter(original[i]);
        i++;
        j++;
    }
    pldm[j] = '\0';
}

int palindroma(const char *texto, const char *busqueda) {
    char texto_norm[MAX_CAMPO];
    char busca_norm[MAX_CAMPO];
    palindroma_string(texto,    texto_norm, MAX_CAMPO);
    palindroma_string(busqueda, busca_norm, MAX_CAMPO);

    int len = strlen(busca_norm);
    int encontrado = 0;
    int i = 0;

    while (texto_norm[i] != '\0' && encontrado == 0) {
        if (texto_norm[i] == busca_norm[0]) {
            int j = 0;
            int coincide = 1;
            while (j < len && coincide == 1) {
                if (texto_norm[i + j] == '\0' ||
                    texto_norm[i + j] != busca_norm[j]) {
                    coincide = 0;
                }
                j++;
            }
            if (coincide == 1) {
                encontrado = 1;
            }
        }
        i++;
    }
    return encontrado;
}

// Función para buscar por columnas lo que se quiera
void extraer_campo(const char *linea, int col, char *dest, int dest_size) {
    char sep;
	// Busca los posibles separadores de la lista
    if      (strchr(linea, ' ') != NULL) sep = ' ';

	// Elige la fila en la que esta
    const char *p    = linea;
    int campo_actual = 0;
	// Avanza en dicha linea
    while (*p != '\0' && campo_actual < col) {
        if (*p == sep) campo_actual++;
        p++;
    }
	// Copia los datos de la columna en "dest[]"
    int i = 0;
    while (*p != '\0' && *p != sep && *p != '\n' && *p != '\r' && i < dest_size - 1)
        dest[i++] = *p++;
    dest[i] = '\0';
}

// Con la funcion anterior, guarda cada linea en una structura actividad
int cargar_actividad(const char *linea, Actividad *a) {
    char aux0[MAX_CAMPO];

    extraer_campo(linea,  0, aux0,               sizeof(aux0));        a->anio     = atoi(aux0);
    extraer_campo(linea,  1, aux0,               sizeof(aux0));        a->mes      = atoi(aux0);
    extraer_campo(linea,  2, aux0,               sizeof(aux0));        a->dia      = atoi(aux0);
    extraer_campo(linea,  3, a->dia_semana,     sizeof(a->dia_semana));
    extraer_campo(linea,  4, a->hora_inicio,    sizeof(a->hora_inicio));
    extraer_campo(linea,  5, a->hora_fin,       sizeof(a->hora_fin));
    extraer_campo(linea,  6, a->actividad_base, sizeof(a->actividad_base));
    extraer_campo(linea,  7, a->modalidad,      sizeof(a->modalidad));
    extraer_campo(linea,  8, a->centro,         sizeof(a->centro));
    extraer_campo(linea,  9, aux0,               sizeof(aux0));        a->plazas   = atoi(aux0);
    extraer_campo(linea, 10, aux0,               sizeof(aux0));        a->ocupadas = atoi(aux0);
    extraer_campo(linea, 11, aux0,               sizeof(aux0));        a->libres   = atoi(aux0);
    extraer_campo(linea, 12, a->tipo_actividad, sizeof(a->tipo_actividad));

    if (a->dia_semana[0] != '\0')
    return 1;
	else
    return 0;
}


// Funcion de ordenacion descendente para no estar repitiendola todo el rato
void orden_descendente(DiaSemana dias[], int n) {
    int i, j;
    DiaSemana aux0;
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (dias[j].ocupadas_total < dias[j + 1].ocupadas_total) {
                aux0         = dias[j];
                dias[j]     = dias[j + 1];
                dias[j + 1] = aux0;
            }
        }
    }
}


int buscar_o_crear_dia(DiaSemana dias[], int *n_dias, const char *nombre) {
    int i;
// Busca si el dia existe
    for (i = 0; i < *n_dias; i++) {
        if (strcmp(dias[i].nombre, nombre) == 0)
            return i;
    }
// Crea el dia nuevo
   strncpy(dias[*n_dias].nombre, nombre, MAX_CAMPO - 1); //	MAX CAMPO-1 para dejar un espacio al final
    dias[*n_dias].nombre[MAX_CAMPO - 1] = '\0'; // El espacio de antes lo cubre cerrando el array
    dias[*n_dias].ocupadas_total = 0;
    dias[*n_dias].registros = 0;
    return (*n_dias)++; // Va incrementando para pasar al siguiente dia
}


