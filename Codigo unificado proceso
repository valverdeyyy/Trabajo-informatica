// 10. Estadisticas generales
// Ordena el array de días de mayor a menor por ocupación
void orden_descendente(DiaSemana dias[], int n) {
    int i, j;
    DiaSemana aux;
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (dias[j].ocupadas_total < dias[j + 1].ocupadas_total) {
                aux = dias[j];
                dias[j] = dias[j + 1];
                dias[j + 1] = aux;
            }
        }
    }
}

/* Dibuja una barra  proporcional al valor */
void imprimir_barra(int valor, int maximo) {
    int ancho  = 40;
    int llenas = (maximo > 0) ? (valor * ancho) / maximo : 0;
    int i;
    printf("[");
    for (i = 0; i < ancho; i++)
        printf(i < llenas ? "#" : " ");
    printf("]");
}

/* Busca un día por nombre; si no existe, lo crea. Devuelve el índice. */
int buscar_o_crear_dia(DiaSemana dias[], int *n_dias, const char *nombre) {
    int i;
    for (i = 0; i < *n_dias; i++) {
        if (strcmp(dias[i].nombre, nombre) == 0)
            return i;
    }
    /* Crear un día nuevo */
    strncpy(dias[*n_dias].nombre, nombre, MAX_CAMPO - 1);
    dias[*n_dias].nombre[MAX_CAMPO - 1] = '\0';
    dias[*n_dias].ocupadas_total        = 0;
    dias[*n_dias].registros             = 0;
    return (*n_dias)++;
}

int dia_mas_actividad_general() {
    DiaSemana dias[MAX_DIAS];
    int n_dias = 0;
    int i;

    /* Recorrer todas las actividades cargadas y acumular por día */
    for (i = 0; i < total; i++) {
        int idx = buscar_o_crear_dia(dias, &n_dias, actividades[i].dia_semana);
        dias[idx].ocupadas_total += actividades[i].ocupadas;
        dias[idx].registros++;
    }

    if (n_dias == 0) {
        printf("No se encontraron datos validos.\n");
        return 0;
    }

    /* Ordenar de mayor a menor */
    orden_descendente(dias, n_dias);

    /* Calcular totales */
    int ocupadas_max    = dias[0].ocupadas_total;
    int ocupadas_global = 0;
    for (i = 0; i < n_dias; i++)
        ocupadas_global += dias[i].ocupadas_total;

    /* SALIDA */
    printf("\n");
    printf("==========================================================\n");
    printf("      ANALISIS DE POPULARIDAD POR DIA DE SEMANA\n");
    printf("==========================================================\n\n");

    printf("  Actividades leidas : %d\n",   total);
    printf("  Dias distintos     : %d\n\n", n_dias);

    printf("  %10s  %10s  %10s 	 %5s \n",
           "DIA", "PLAZAS OC.", "ACTIVIDADES", "% TOTAL");

    for (i = 0; i < n_dias; i++) {
        int pct_x10;
        if (ocupadas_global > 0) {
            pct_x10 = (dias[i].ocupadas_total * 1000) / ocupadas_global;
        } else {
            pct_x10 = 0;
        }

        printf("  %10s  %10d  %10d    %5d.%d%%  ",
               dias[i].nombre,
               dias[i].ocupadas_total,
               dias[i].registros,
               pct_x10 / 10,
               pct_x10 % 10);

    }

    printf("  ---------------------------------------------------------------------------\n");
    printf("  %10s  %10d  %10d    100.0%%\n",
           "TOTAL", ocupadas_global, total);

    int top_pct_x10 = (ocupadas_global > 0)
                      ? (dias[0].ocupadas_total * 1000) / ocupadas_global : 0;

    printf("  ---------------------------------------------------------------------------\n\n");
    printf("     DIA MAS POPULAR : %s\n",  dias[0].nombre);
    printf("     Plazas ocupadas : %d\n",  dias[0].ocupadas_total);
    printf("     Registros       : %d\n",  dias[0].registros);
    printf("     Porcentaje      : %d.%d%% del total de ocupacion\n\n",
           top_pct_x10 / 10, top_pct_x10 % 10);

    return 1;
}

int actividades_mas_populares_general() {
    DiaSemana acts[MAX_TIPOS_ACTIVIDAD];
    int n_acts = 0;
    int i;

    /* Inicializar el array */
    for (i = 0; i < MAX_TIPOS_ACTIVIDAD; i++) {
        acts[i].nombre[0]      = '\0';
        acts[i].ocupadas_total = 0;
        acts[i].registros      = 0;
        acts[i].plazas_total   = 0;
    }

    /* Acumular por tipo de actividad (reutilizamos buscar_o_crear_dia) */
    for (i = 0; i < total; i++) {
        int idx = buscar_o_crear_dia(acts, &n_acts, actividades[i].actividad_base);
        if (idx >= 0) {
            acts[idx].ocupadas_total += actividades[i].ocupadas;
            acts[idx].plazas_total   += actividades[i].plazas;
            acts[idx].registros++;
        }
    }

    /* Ordenar de mayor a menor por ocupación */
    orden_descendente(acts, n_acts);

    int total_ocupadas = 0;
    int total_plazas   = 0;
    for (i = 0; i < n_acts; i++) {
        total_ocupadas += acts[i].ocupadas_total;
        total_plazas   += acts[i].plazas_total;
    }

    printf("\n");
    printf("==========================================================\n");
    printf("        RANKING DE ACTIVIDADES POR POPULARIDAD\n");
    printf("==========================================================\n\n");

    printf("  %-5s  %-45s  %10s  %10s  %10s  %10s\n",
           "POS", "ACTIVIDAD", "OCUPADAS", "PLAZAS", "OCUP. %", "% TOTAL");
    printf("  ------------------------------------------------------------------------------------------------\n");

    for (i = 0; i < n_acts; i++) {
        // % de ocupación de cada actividad respecto a sus propias plazas
        int oc_x10  = (acts[i].plazas_total > 0)
                      ? (acts[i].ocupadas_total * 1000) / acts[i].plazas_total : 0;
        // % del total de plazas ocupadas que se lleva esta actividad
        int pct_x10 = (total_ocupadas > 0)
                      ? (acts[i].ocupadas_total * 1000) / total_ocupadas : 0;

        printf("  %-5d  %-45s  %10d  %10d  %7d.%d%%  %7d.%d%%\n",
               i + 1,
               acts[i].nombre,
               acts[i].ocupadas_total,
               acts[i].plazas_total,
               oc_x10  / 10, oc_x10  % 10,
               pct_x10 / 10, pct_x10 % 10);
    }

    printf("  ------------------------------------------------------------------------------------------------\n");
    printf("  %-5s  %-45s  %10d  %10d\n\n", "", "TOTAL", total_ocupadas, total_plazas);

    if (n_acts > 0) {
        printf("  >>> ACTIVIDAD MAS POPULAR : %s\n",   acts[0].nombre);
        printf("      Plazas ocupadas       : %d\n",   acts[0].ocupadas_total);
        printf("      Plazas totales        : %d\n",   acts[0].plazas_total);
        printf("      Sesiones registradas  : %d\n\n", acts[0].registros);
    }

    return n_acts;
}

// 11. BLOQUE LIMA — Estadísticas por centro
// Convierte un carácter para hacer búsquedas flexibles:
// Funcion inspirada por el ejercicio del parcial
char palindroma_caracter(char c) {
    char resultado = c;
    if (c == '_') {		// Guión bajo '_' a espacio ' '
        resultado = ' ';
    } else if (c >= 'A' && c <= 'Z') {
        resultado = (c + 32); // Mayúsculas a minúsculas
    }
    return resultado;
}

// Aplica palindroma_caracter a toda una cadena
void palindroma_string(const char *original, char *destino, int max) {
    int i = 0, j = 0;
    while (original[i] != '\0' && j < max - 1) {
        destino[j] = palindroma_caracter(original[i]);
        i++;
        j++;
    }
    destino[j] = '\0';
}

//Compara
int palindroma(const char *texto, const char *busqueda) {
    char texto_norm[MAX_CAMPO];
    char busca_norm[MAX_CAMPO];
    palindroma_string(texto, texto_norm, MAX_CAMPO);
    palindroma_string(busqueda, busca_norm, MAX_CAMPO);

    int len = strlen(busca_norm);
    int encontrado = 0;
    int i = 0;

    while (texto_norm[i] != '\0' && encontrado == 0) {
        if (texto_norm[i] == busca_norm[0]) {
            int j = 0;
            int coincide = 1;
            while (j < len && coincide == 1) {
                if (texto_norm[i + j] == '\0' ||
                    texto_norm[i + j] != busca_norm[j]) {
                    coincide = 0;
                }
                j++;
            }
            if (coincide == 1) {
                encontrado = 1;
            }
        }
        i++;
    }
    return encontrado;
}

// Calcula y muestra el día más activo y la actividad top de cada centro
int dia_mas_actividad_por_centro() {
    InfoCentro centros[MAX_CENTROS];
    int n_centros = 0;
    int i;

    // Inicializar el array de centros
    for (i = 0; i < MAX_CENTROS; i++) {
        centros[i].nombre[0]        = '\0';
        centros[i].dia_top[0]       = '\0';
        centros[i].actividad_top[0] = '\0';
        centros[i].max_ocupacion    = -1;
    }

    // Recorrer todas las actividades
    for (i = 0; i < total; i++) {
        // Buscar si el centro ya existe
        int idx_centro = -1;
        int c = 0;
        while (c < n_centros && idx_centro == -1) {
            if (strcmp(centros[c].nombre, actividades[i].centro) == 0)
                idx_centro = c;
            c++;
        }

        // Si es nuevo, lo añadimos
        if (idx_centro == -1 && n_centros < MAX_CENTROS) {
            idx_centro = n_centros;
            strncpy(centros[idx_centro].nombre, actividades[i].centro, MAX_CAMPO - 1);
            centros[idx_centro].nombre[MAX_CAMPO - 1] = '\0';
            centros[idx_centro].max_ocupacion = -1;
            n_centros++;
        }

        // Actualizamos el récord si esta actividad lo supera
        if (idx_centro != -1) {
            if (actividades[i].ocupadas >= centros[idx_centro].max_ocupacion) {
                centros[idx_centro].max_ocupacion = actividades[i].ocupadas;
                strncpy(centros[idx_centro].dia_top,actividades[i].dia_semana, MAX_CAMPO - 1);
                strncpy(centros[idx_centro].actividad_top, actividades[i].actividad_base, MAX_CAMPO - 1);
                centros[idx_centro].dia_top[MAX_CAMPO - 1] = '\0';
                centros[idx_centro].actividad_top[MAX_CAMPO - 1] = '\0';
            }
        }
    }

    // Tabla resumen
    printf("\n");
    printf("==========================================================\n");
    printf("         ANALISIS DE ACTIVIDAD POR CENTRO\n");
    printf("==========================================================\n");
    printf("   %-30s | %-12s | %s\n", "CENTRO", "DIA MAS ACT.", "ACTIVIDAD TOP");


    for (i = 0; i < n_centros; i++) {
        printf("   %-30s | %-12s | %s\n",
               centros[i].nombre, centros[i].dia_top, centros[i].actividad_top);
    }
    printf("\n");

    return n_centros;
}

// Igual que dia_mas_actividad_por_centro pero centrado en la actividad top
int actividades_populares_por_centro() {
    /* La lógica es la misma; reutilizamos la función. La tabla ya muestra
       la actividad top de cada centro. */
    return dia_mas_actividad_por_centro();
}

/* Pide al usuario un texto y muestra los horarios de los centros que coinciden */
int horarios_de_centro() {
    char busca_centro[MAX_CAMPO];
    int i;
    int encontrados = 0;

    printf("\n   ¿De que centro quieres ver los horarios? ");
    leer_linea(busca_centro, MAX_CAMPO);

    if (busca_centro[0] == '\0') {
        printf("   No se ha introducido ningun nombre.\n");
        return 0;
    }

    printf("\n   Horarios en centros que coinciden con '%s':\n\n", busca_centro);
    printf("   %-25s  %-12s  %-8s  %-8s  %s\n",
           "CENTRO", "DIA", "INICIO", "FIN", "ACTIVIDAD");
    printf("   ------------------------------------------------------------------------------\n");

    for (i = 0; i < total; i++) {
        if (palindroma(actividades[i].centro, busca_centro) == 1) {
            printf("   %-25s  %-12s  %-8s  %-8s  %s\n",
                   actividades[i].centro,
                   actividades[i].dia_semana,
                   actividades[i].hora_inicio,
                   actividades[i].hora_fin,
                   actividades[i].actividad_base);
            encontrados++;
        }
    }

    if (encontrados == 0) {
        printf("   No se encontraron resultados para '%s'.\n", busca_centro);
    } else {
        printf("\n   Total encontrados: %d\n", encontrados);
    }
    printf("\n");
    return encontrados;
}

