// 6. CARGA DEL FICHERO
int cargar_csv(const char *ruta) {
    FILE *f = fopen(ruta, "r");
    if (f == NULL) {
        printf("Error: no se pudo abrir '%s'\n", ruta);
        return 0;
    }

    char linea[512];
    fgets(linea, sizeof(linea), f);

    total = 0;
    while (fgets(linea, sizeof(linea), f) != NULL && total < MAX_ACTIVIDADES) {
        linea[strcspn(linea, "\n")] = '\0';

        Actividad a;
        int leidos = sscanf(linea,
            "%d %d %d %s %s %s %s %s %s %d %d %d %s",
            &a.anio, &a.mes, &a.dia,
            a.dia_semana,
            a.hora_inicio, a.hora_fin,
            a.actividad_base, a.modalidad, a.centro,
            &a.plazas, &a.ocupadas, &a.libres,
            a.tipo_actividad);

        if (leidos == 13) {
            a.completada = 0;
            actividades[total] = a;
            total++;
        }
    }

    fclose(f);
    printf("Se cargaron %d actividades.\n\n", total);
    return 1;
}

// 7. Login y recomendación
/* Lee una línea del teclado eliminando el salto de línea final.
   Si el usuario solo pulsa Enter, devuelve cadena vacía. */
void leer_linea(char *destino, int tamano) {
    if (fgets(destino, tamano, stdin) != NULL) {
        destino[strcspn(destino, "\n")] = '\0';
    } else {
        destino[0] = '\0';
    }
}

// Cambia un char a un int
int leer_entero() {
    char buffer[MAX_CAMPO];
    leer_linea(buffer, MAX_CAMPO);
    int n = 0, signo = 1, i = 0;
    if (buffer[0] == '-') { signo = -1; i = 1; }
    while (buffer[i] >= '0' && buffer[i] <= '9') {
        n = n * 10 + (buffer[i] - '0');
        i++;
    }
    return n * signo;
}

