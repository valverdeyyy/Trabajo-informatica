    printf("         BUSCADOR DE ACTIVIDADES\n");
    printf("==========================================================\n\n");
    printf("  Buscando actividades segun los datos del login.\n");
    printf("  (Si quieres cambiar algun criterio, escribelo; deja en\n");
    printf("   blanco y pulsa Enter para usar el del login)\n\n");

    char hora[MAX_CAMPO];
    char actividad[MAX_CAMPO];
    char centro[MAX_CAMPO];

    printf("  Hora de inicio [%s]: ", usuario_actual.horario);
    leer_linea(hora, MAX_CAMPO);
    if (hora[0] == '\0') strcpy(hora, usuario_actual.horario);

    printf("  Actividad      [%s]: ", usuario_actual.actividad_deseada);
    leer_linea(actividad, MAX_CAMPO);
    if (actividad[0] == '\0') strcpy(actividad, usuario_actual.actividad_deseada);

    printf("  Centro         [%s]: ", usuario_actual.lugar);
    leer_linea(centro, MAX_CAMPO);
    if (centro[0] == '\0') strcpy(centro, usuario_actual.lugar);

    int encontrados = buscar_recomendaciones(hora, actividad, centro);

    if (encontrados == 0) {
        printf("\n  No se encontraron actividades con esos criterios.\n");
    } else {
        printf("\n  Total encontradas: %d\n", encontrados);
    }
    printf("\n");

    return encontrados;
}

int es_util_recomendacion() {
    char respuesta[MAX_CAMPO];
    printf("\n¿Es util la recomendacion? (s/n): ");
    leer_linea(respuesta, MAX_CAMPO);
    return (respuesta[0] == 's' || respuesta[0] == 'S');
}

