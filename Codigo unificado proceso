/* Busca actividades en el array global que coincidan con los filtros.
   Si un filtro está vacío ("") se ignora ese campo. */
int buscar_recomendaciones(const char *hora, const char *actividad, const char *centro) {
    int encontrados = 0;
    int i;

    for (i = 0; i < total; i++) {
        int coincide_hora      = (hora[0]      == '\0') || (strcmp(actividades[i].hora_inicio,    hora)      == 0);
        int coincide_actividad = (actividad[0] == '\0') || (strcmp(actividades[i].actividad_base, actividad) == 0);
        int coincide_centro    = (centro[0]    == '\0') || (strcmp(actividades[i].centro,         centro)    == 0);

        if (coincide_hora && coincide_actividad && coincide_centro) {
            if (encontrados == 0) {
                printf("\n  %-12s  %-30s  %-8s  %-8s  %-30s  %s\n",
                       "DIA", "ACTIVIDAD", "INICIO", "FIN", "CENTRO", "LIBRES");
                printf("  -------------------------------------------------------------------------------------------------------\n");
            }
            printf("  %-12s  %-30s  %-8s  %-8s  %-30s  %d\n",
                   actividades[i].dia_semana,
                   actividades[i].actividad_base,
                   actividades[i].hora_inicio,
                   actividades[i].hora_fin,
                   actividades[i].centro,
                   actividades[i].libres);
            encontrados++;
        }
    }
    return encontrados;
}

int recomendar() {
