// Usando strcmp y tres variables i, j, e intercambios (aux) va ordenando las actividades alfabeticamente según la columna centro
int ordenar_por_lugar() {
    int i, j, intercambios = 0;
    Actividad temp;
    for (i = 0; i < total - 1; i++) {
        for (j = 0; j < total - 1 - i; j++) {
            if (strcmp(actividades[j].centro, actividades[j+1].centro) > 0) {
                temp = actividades[j];
                actividades[j] = actividades[j+1];
                actividades[j+1] = temp;
                intercambios++;
            }
        }
    }
    return intercambios;
}
// Usando strcmp y tres variables i, j, e intercambios va ordenando las actividades alfabeticamente según la columna hora_inicio
int ordenar_por_horario() {
    int i, j, intercambios = 0;
    Actividad temp;
    for (i = 0; i < total - 1; i++) {
        for (j = 0; j < total - 1 - i; j++) {
            if (hora_a_minutos(actividades[j].hora_inicio) >
                hora_a_minutos(actividades[j+1].hora_inicio)) {
                temp = actividades[j];
                actividades[j] = actividades[j+1];
                actividades[j+1] = temp;
                intercambios++;
            }
        }
    }
    return intercambios;
}
