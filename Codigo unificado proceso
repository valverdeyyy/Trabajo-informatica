                flujo_elegir_actividad();
                break;

            case 0:
                printf("Hasta luego, %s\n", usuario_actual.nombre);
                break;

            default:
                printf("Tiene que escribir una opcion valida.\n");
        }
    } while (opcion != 0);

    return 0;
}
