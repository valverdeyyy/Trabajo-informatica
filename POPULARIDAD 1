/* Lee dataset.csv, carga cada fila en un array de structs Actividad,
  determina que dia de la semana tiene mayor popularidad (suma de
  plazas ocupadas) y muestra los días ordenados de mayor a menor.
  */
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX_ACTIVIDADES 5100
#define MAX_CAMPO        64
#define MAX_DIAS          7
#define MAX_LINEA       512

#define EXITO  0
#define ERROR  1

// Estructura principal
typedef struct {
    int  anio;
    int  mes;
    int  dia;
    char dia_semana[MAX_CAMPO];
    char hora_inicio[MAX_CAMPO];
    char hora_fin[MAX_CAMPO];
    char actividad_base[MAX_CAMPO];
    char modalidad[MAX_CAMPO];
    char centro[MAX_CAMPO];
    int  plazas;
    int  ocupadas;
    int  libres;
    char tipo_actividad[MAX_CAMPO];
} Actividad;

// Estructura auxiliar para la popularidad por dia
typedef struct {
    char nombre[MAX_CAMPO];
    int  ocupadas_total;
    int  registros;
} DiaSemana;

// Funcion para convertir texto (string) en numero (int)
// El nombre es por una funcion "universal" de otra libreria no disponible
int atoi(const char *s) {

	int resultado = 0;  // Para guardar el número
    int signo     = 1;  // Por si es negativo

    while (*s == ' ' || *s == '\t') s++;

    if      (*s == '-') { signo = -1; s++; }
    else if (*s == '+') { s++; }

    while (*s >= '0' && *s <= '9') {
        resultado = resultado * 10 + (*s - '0'); // Si tien mas de decenas, las va "moviendo" a la izquierda
        s++;
    }
    return signo * resultado;
}



// Función para buscar por columnas lo que se quiera
void extraer_campo(const char *linea, int col, char *dest, int dest_size) {
    char sep;
// Busca los posibles separadores de la lista
    if      (strchr(linea, ';') != NULL) sep = ';';
    else if (strchr(linea, ',') != NULL) sep = ',';
    else                                  sep = ' ';
// Elige la fila en la que esta
    const char *p    = linea;
    int campo_actual = 0;
// Avanza en dicha linea
    while (*p != '\0' && campo_actual < col) {
        if (*p == sep) campo_actual++;
        p++;
    }
// Copia los datos de la columna en "dest[]"
    int i = 0;
    while (*p != '\0' && *p != sep && *p != '\n' && *p != '\r' && i < dest_size - 1)
        dest[i++] = *p++;
    dest[i] = '\0';
}

// Con la funcion anterior, guarda cada linea en una structura actividad
int cargar_actividad(const char *linea, Actividad *a) {
    char aux0[MAX_CAMPO];

    extraer_campo(linea,  0, aux0,               sizeof(aux0));        a->anio     = atoi(aux0);
    extraer_campo(linea,  1, aux0,               sizeof(aux0));        a->mes      = atoi(aux0);
    extraer_campo(linea,  2, aux0,               sizeof(aux0));        a->dia      = atoi(aux0);
    extraer_campo(linea,  3, a->dia_semana,     sizeof(a->dia_semana));
    extraer_campo(linea,  4, a->hora_inicio,    sizeof(a->hora_inicio));
    extraer_campo(linea,  5, a->hora_fin,       sizeof(a->hora_fin));
    extraer_campo(linea,  6, a->actividad_base, sizeof(a->actividad_base));
    extraer_campo(linea,  7, a->modalidad,      sizeof(a->modalidad));
    extraer_campo(linea,  8, a->centro,         sizeof(a->centro));
    extraer_campo(linea,  9, aux0,               sizeof(aux0));        a->plazas   = atoi(aux0);
    extraer_campo(linea, 10, aux0,               sizeof(aux0));        a->ocupadas = atoi(aux0);
    extraer_campo(linea, 11, aux0,               sizeof(aux0));        a->libres   = atoi(aux0);
    extraer_campo(linea, 12, a->tipo_actividad, sizeof(a->tipo_actividad));

    if (a->dia_semana[0] != '\0')
    return 1;
	else
    return 0;
}


// Funcion de ordenacion descendente para no estar repitiendola todo el rato
void orden_descendente(DiaSemana dias[], int n) {
    int i, j;
    DiaSemana aux0;
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (dias[j].ocupadas_total < dias[j + 1].ocupadas_total) {
                aux0         = dias[j];
                dias[j]     = dias[j + 1];
                dias[j + 1] = aux0;
            }
        }
    }
}

// Funcion para ver de manera grafica la popularidad
void imprimir_barra(int valor, int maximo) {
    int ancho  = 40;
    int llenas = (maximo > 0) ? (valor * ancho) / maximo : 0;
    int i;
    printf("[");
    for (i = 0; i < ancho; i++)
        printf(i < llenas ? "#" : " ");
    printf("]");
}


int buscar_o_crear_dia(DiaSemana dias[], int *n_dias, const char *nombre) {
    int i;
// Busca si el dia existe
    for (i = 0; i < *n_dias; i++) {
        if (strcmp(dias[i].nombre, nombre) == 0)
            return i;
    }
// Crea el dia nuevo
   strncpy(dias[*n_dias].nombre, nombre, MAX_CAMPO - 1); //	MAX CAMPO-1 para dejar un espacio al final
    dias[*n_dias].nombre[MAX_CAMPO - 1] = '\0'; // El espacio de antes lo cubre cerrando el array
    dias[*n_dias].ocupadas_total         = 0;
    dias[*n_dias].registros              = 0;
    return (*n_dias)++; // Va incrementando para pasar al siguiente dia
}


// MAIN
int main() {

    FILE *fp = fopen("dataset.csv", "r");

    // Array principal, MEMORIA DINAMICA
   Actividad * actividades = (Actividad*) malloc(MAX_ACTIVIDADES * sizeof(*actividades));
   	 if (actividades == NULL) {
        printf("Error: memoria no disponible\n");
		 return -1;
    }
   // Al ser punteros de diferente tipo (void != Actividad) tengo que forzar que el void se convierta en Actividad con (Actividad*)
   // cast incluido por si se compila como C++


	int n_actividades = 0;

    // Array auxiliar de dias
    DiaSemana dias[MAX_DIAS];
    int n_dias = 0;

    char linea[MAX_LINEA];
    int  i;

// Comprobar que no este vacio
 char *resultado;
resultado = fgets(linea, sizeof(linea), fp);

if (resultado == NULL) {
    fprintf(stderr, "Error: archivo vacio.\n");
    fclose(fp);
    return 1;
}


 int error = 0;
    while (fgets(linea, sizeof(linea), fp) && n_actividades < MAX_ACTIVIDADES && error == 0) {
        if (linea[0] != '\n' && linea[0] != '\r') {
            Actividad a;  // variable temporal
            if (cargar_actividad(linea, &a) != 0) {
                actividades[n_actividades] = a;
                n_actividades++;

				// Utilizando la funcion de antes busca o crea el dia
                int idx = buscar_o_crear_dia(dias, &n_dias, actividades[n_actividades - 1].dia_semana);
                if (idx < 0) {
                    error = 1;  // Frenar en caso de fallo (que devuelva negativo)
                }
				else {
				 	dias[idx].ocupadas_total += actividades[n_actividades - 1].ocupadas;
					// Acumulador de todas las plazas ocupadas
                    dias[idx].registros++;  // Contador de registros
                }
            }
        }
    }
    fclose(fp);

    if (error != 0) {
        return 1;
    }

    if (n_dias == 0) {
        fprintf(stderr, "No se encontraron datos validos.\n");
        return 1;
    }

	// Usando la funcion de antes ordenar de forma descendente
    orden_descendente(dias, n_dias);

    // Calcular totales
    int ocupadas_max    = dias[0].ocupadas_total;
    int ocupadas_global = 0;
    for (i = 0; i < n_dias; i++)
        ocupadas_global += dias[i].ocupadas_total; //Acumulador de todas las ocupadas

    //SALIDA
    printf("\n");
    printf("==========================================================\n");
    printf("      ANALISIS DE POPULARIDAD POR DIA DE SEMANA\n");
    printf("==========================================================\n\n");

    printf("  Actividades leidas : %d\n",   n_actividades);
    printf("  Dias distintos     : %d\n\n", n_dias);

    printf("  %10s  %11s  %11s 	 %7s  %40s\n",
           "DIA", "PLAZAS OC.", "ACTIVIDADES", "% TOTAL", "BARRA DE POPULARIDAD");
    printf("  ---------------------------------------------------------------------------\n");

    for (i = 0; i < n_dias; i++) {
        // Porcentaje con 1 decimal: multiplicamos x1000 para no tener que usar float
        int pct_x10;

		if (ocupadas_global > 0) {
   		 pct_x10 = (dias[i].ocupadas_total * 1000) / ocupadas_global;
		} else {
    	pct_x10 = 0;
		}

        printf("  %10s  %11d  %11d	  %3d.%d%%  ",
               dias[i].nombre,
               dias[i].ocupadas_total,
               dias[i].registros,
               pct_x10 / 10,
               pct_x10 % 10);

        imprimir_barra(dias[i].ocupadas_total, ocupadas_max);
        printf("\n");
    }

    printf("  ---------------------------------------------------------------------------\n");
    printf("  %10s  %11d  %11d	  100.0%%\n",
           "TOTAL", ocupadas_global, n_actividades);

    // Resumen final con lo mas popular
    int top_pct_x10 = (ocupadas_global > 0)
                      ? (dias[0].ocupadas_total * 1000) / ocupadas_global : 0;

 printf("  ---------------------------------------------------------------------------\n\n");
    printf("     DIA MAS POPULAR : %s\n",  dias[0].nombre);
    printf("     Plazas ocupadas : %d\n",  dias[0].ocupadas_total);
    printf("     Registros       : %d\n",  dias[0].registros);
